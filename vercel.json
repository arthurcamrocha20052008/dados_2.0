{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/login", "destination": "/frontend/login.html" },
    { "source": "/login.html", "destination": "/frontend/login.html" },
    { "source": "/cadastro", "destination": "/frontend/cadastro.html" },
    { "source": "/cadastro.html", "destination": "/frontend/cadastro.html" },
    { "source": "/index.html", "destination": "/frontend/index.html" },
    { "source": "/manifest.json", "destination": "/frontend/manifest.json" },
    { "source": "/js/(.*)", "destination": "/frontend/js/$1" },
    { "source": "/", "destination": "/frontend/index.html" }
  ]
}
